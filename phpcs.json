{
  "extends": "psr12",
  "tab-width": 4,
  "line-length": 120,
  "rules": {
    "indentation": {
      "indent-type": true,
      "size": 4
    },
    "line-length": {
      "max-length": 120,
      "ignore-pattern": true,
      "ignore-comments": false,
      "ignore-annotations": false
    },
    "spaces": {
      "around-concat": true,
      "after-comma": true,
      "before-comma": false
    },
    "class-declaration": {
      "class-modifier": "required"
    },
    "control-structures": {
      "declare-strict-types": true
    },
    "php-open-tag": {
      "open-tag-alone": true
    },
    "namespace-declaration": {
      "namespace-declaration": true
    },
    "use-statements": {
      "order": "alphabetical"
    },
    "spacing": {
      "method-arguments": 1
    },
    "naming": {
      "interfaces": "Interface$"
    }
  },
  "exclude": [
    "vendor/",
    "tests/",
    ".git/"
  ]
}
