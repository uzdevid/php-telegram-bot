{
  "name": "uzdevid/php-telegram-bot",
  "description": "An object-oriented PHP wrapper for the Telegram Bot API: a client for calling methods and a server for handling updates.",
  "type": "library",
  "keywords": [
    "php",
    "extension",
    "telegram",
    "bot"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Ibragimov Diyorbek",
      "email": "uzdevid@gmail.com"
    }
  ],
  "require": {
    "php": ">=8.2",
    "guzzlehttp/guzzle": "^7.8",
    "yiisoft/hydrator": "^1.2.0",
    "psr/container": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "UzDevid\\Telegram\\Bot\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "UzDevid\\Telegram\\Bot\\Tests\\": "tests"
    }
  },
  "require-dev": {
    "squizlabs/php_codesniffer": "3.13.5",
    "phpstan/phpstan": "^1.10",
    "friendsofphp/php-cs-fixer": "^3.40"
  },
  "scripts": {
    "lint": "php-cs-fixer fix --dry-run --diff",
    "lint:fix": "php-cs-fixer fix",
    "phpcs": "phpcs -n --standard=phpcs.xml src/",
    "phpstan": "phpstan analyse --configuration=phpstan.neon src/",
    "static-analysis": [
      "@phpcs",
      "@phpstan"
    ]
  },
  "config": {
    "sort-packages": true
  }
}
